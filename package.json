{
  "name": "auto-resume",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "node scripts/serve.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "katex": "0.19.1",
    "markdown-it": "14.3.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-ins": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0",
    "pagedjs": "0.4.3"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "prettier": "3.9.10"
  },
  "description": "A flexible resume editor with Markdown, photos, local drafts and A4 PDF export.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tqzhong/auto-resume.git"
  },
  "homepage": "https://github.com/tqzhong/auto-resume#readme",
  "bugs": {
    "url": "https://github.com/tqzhong/auto-resume/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
